# Private runtime data — never commit (contains briefs.db with private user notes + WAL/SHM)
data/

# Python virtualenv (local, not reproducible by commit)
.venv/

# Python bytecode and tool caches
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/


# macOS Finder metadata
.DS_Store

# Transient rehearsal state written by deploy tooling
deploy/rehearsal-pids.json

# Logs
*.log

# Rollback copies of the tui skin kept on-host by the design pass
static/css/*.bak-*

# Node tooling (eslint/prettier) installed per checkout
node_modules/

# Next.js build artifacts (rebuilt by make build-frontend)
frontend/.next/
frontend/out/
frontend/tsconfig.tsbuildinfo
frontend/tsconfig.e2e.tsbuildinfo

# Playwright e2e output
frontend/test-results/
frontend/playwright-report/
